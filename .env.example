# Copy this file to `.env` and fill in your tenant's values.
# `.env` is gitignored — never commit real tokens.
#
# DT_ENV_URL             Your Dynatrace tenant URL, no trailing slash.
#                        Format: https://<tenant>.apps.dynatrace.com
#                        Dev tenants: https://<tenant>.dev.apps.dynatracelabs.com
#
# DT_PLATFORM_TOKEN      Platform token with these scopes:
#                          - storage:events:write   (bizevents ingest)
#                          - logs.ingest            (log ingest)
#                          - metrics.ingest         (metric ingest)
#                        Mint at: your tenant → Account Management → Access Tokens.
#
# DT_BIZEVENT_PROVIDER   Provider slug the app filters on. Leave as the default
#                        `demo-retail.ops-health` unless you're customizing.

DT_ENV_URL=https://REPLACE-ME.apps.dynatrace.com
DT_PLATFORM_TOKEN=REPLACE_WITH_PLATFORM_TOKEN
DT_BIZEVENT_PROVIDER=demo-retail.ops-health
